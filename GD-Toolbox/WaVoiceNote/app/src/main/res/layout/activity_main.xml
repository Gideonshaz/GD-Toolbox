<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GD Toolbox"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- 1. Audio -> Voice Note -->
        <Button
            android:id="@+id/btnAudioToVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙  Audio → WhatsApp Voice Note" />

        <!-- 2. Voice-note mode toggle -->
        <Button
            android:id="@+id/btnPttToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔁  Voice-note mode: …" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#33888888" />

        <!-- 3/4. Desktop Commander -->
        <Button
            android:id="@+id/btnDcStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️  Start Desktop Commander (root)" />

        <Button
            android:id="@+id/btnDcStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⏹  Stop Desktop Commander" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#33888888" />

        <!-- 5. Mock location -->
        <Button
            android:id="@+id/btnMockToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍  Mock location: …" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Ready." />

    </LinearLayout>
</ScrollView>
